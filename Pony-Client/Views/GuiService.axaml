<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Pony_Client.Services.GuiService"
			 >

	<Grid ColumnDefinitions="*,*,*" RowDefinitions="*,Auto">
			<TextBlock Name="ChatLog" TextWrapping="Wrap" Grid.Row="0" Margin="10" VerticalAlignment="Stretch"/>
			<TextBox Name="ChatInput" IsTabStop="False" Grid.Row="1" Margin="10, 0, 10, 10" Watermark="Press / to Chat" />
	</Grid>
</UserControl>