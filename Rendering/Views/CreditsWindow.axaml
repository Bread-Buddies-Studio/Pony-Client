<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Rendering.Views.CreditsWindow"
		Title="Account"
		RequestedThemeVariant="Dark">

	<StackPanel Margin="20">
		<Label FontSize="65" HorizontalAlignment="Center">Credits</Label>
		<Label Margin="0 10" FontSize="20" HorizontalAlignment="Stretch" Background="Green">Main Studio: Bread Buddies Studios</Label>
		<Label Margin="0 10" FontSize="20" HorizontalAlignment="Stretch" Background="Crimson">Collaborating Studio: WhirlHole Studios</Label>
	</StackPanel>
</Window>